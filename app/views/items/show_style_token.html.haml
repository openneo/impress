- title @item.name
- canonical_path @item
- use_responsive_design

= render partial: "item_header",
  locals: {item: @item, trades: @trades, current_subpage: "preview",
    current_user_lists: @current_user_lists,
    current_user_quantities: @current_user_quantities}

#item-preview{"data-kind": "style-token"}
  .preview-area
    = outfit_viewer @preview_outfit, id: "item-preview-outfit-viewer"
    .error-indicator
      💥 We couldn't load all of this style. Try again?
    = link_to style_token_wardrobe_path(@alt_style),
              class: "customize-more", target: "_blank" do
      %measured-container.customize-more-label
        %measured-content
          Customize more
      = edit_icon

  .style-token-info
    %p
      This is the token for an
      = succeed "," do
        %strong NC Pet Style
      a different look that
      = @alt_style.species.human_name.pluralize
      can switch to at the Styling Studio. Styles have their own body shape,
      so they can only wear items that fit all pets, like backgrounds.
    %ul
      %li
        = link_to "Try this style in the wardrobe",
          style_token_wardrobe_path(@alt_style), target: "_blank"
      %li
        = link_to "Items that fit this style",
          items_path(q: "fits:alt-style-#{@alt_style.id}")
      %li
        = link_to "All #{@alt_style.species.human_name} styles",
          alt_styles_path(species: @alt_style.species.human_name)
      - if @alt_style.real_series_name?
        %li
          = link_to "All #{@alt_style.series_name} styles",
            alt_styles_path(series: @alt_style.series_name)

- content_for :stylesheets do
  = stylesheet_link_tag "application/hanger-spinner"
  = page_stylesheet_link_tag "layouts/items"
  = page_stylesheet_link_tag "items/show"

- content_for :javascripts do
  = javascript_include_tag "outfit-viewer", async: true
  = javascript_include_tag "items/show", async: true
