<% if resource.errors.any? %>
  <div class="error-explanation" data-turbo-cache="false">
    <header>
      <%= I18n.t("errors.messages.not_saved", count: resource.errors.count,
                 resource: "user") %>
    </header>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
