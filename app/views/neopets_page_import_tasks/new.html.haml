- title t('.title', :name => @import_task.page.name, :index => @import_task.page.expected_index)
- content_for :before_flashes do
  = link_to t('.your_items_link'), user_closet_hangers_path(current_user), :id => 'back-to-items'

%p#closet-page-intro= t '.intro', :name => @import_task.page.name

- page_link_text = t('.steps.open_link', :name => @import_task.page.name, :index => @import_task.page.expected_index)
- page_link = link_to(page_link_text, @import_task.page.url, :target => '_blank', :rel => 'noopener')

%ol#closet-page-steps
  %li= t '.steps.open_html', :page_link => page_link
  %li= t '.steps.view_source_html'
  %li= t '.steps.copy_html'

= form_for @import_task, :html => {:id => 'closet-page-form'} do |f|
  #closet-page-source
    = fields_for @import_task.page do |p|
      = p.label :source, t('.source_header')
      = p.text_area :source
  = f.select :list_id, neopets_page_list_options(current_user)
  = f.submit t('.submit')

%p#closet-page-safety-note= t '.safety_note'
